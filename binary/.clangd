CompileFlags:
  Add:
    - -I/work/yahong/riscv-dev/binary/include
    - --target=riscv64-unknown-elf
    - -march=rv64gc_zicbop
    - -mabi=lp64d
    - -mcmodel=medany
    - -fno-builtin
    - -Wall
    - -Wextra
    - -isystem
    - /work/yahong/chipyard/.conda-env/riscv-tools/riscv64-unknown-elf/include
---
If:
  PathMatch: .*\.cpp
CompileFlags:
  Add:
    - -std=c++20
    - -ffreestanding
    - -fno-exceptions
    - -fno-rtti
    - -isystem
    - /work/yahong/chipyard/.conda-env/riscv-tools/riscv64-unknown-elf/include/c++/13.2.0
    - -isystem
    - /work/yahong/chipyard/.conda-env/riscv-tools/riscv64-unknown-elf/include/c++/13.2.0/riscv64-unknown-elf
    - -isystem
    - /work/yahong/chipyard/.conda-env/riscv-tools/riscv64-unknown-elf/include/c++/13.2.0/backward
